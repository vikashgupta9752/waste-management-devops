# =============================================================================
# Docker Environment Variables
# =============================================================================
# This file is used by docker-compose.yml for local Docker development.
# Copy this to .env when running with Docker Compose.
#
# USAGE:
#   docker-compose --env-file .env.docker up -d
#   (or rename to .env if Docker is your primary environment)
# =============================================================================

APP_NAME="Waste Management"
APP_ENV=local
APP_KEY=base64:placeholder-key-run-php-artisan-key-generate
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# =============================================================================
# LOGGING (Enhanced for DevOps monitoring)
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# DATABASE — SQLite (Simple, no extra container needed)
# =============================================================================
DB_CONNECTION=sqlite
# DB_DATABASE is auto-set to database/database.sqlite by Laravel

# =============================================================================
# CACHE & SESSION — Redis (via Docker container)
# =============================================================================
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# =============================================================================
# MAIL (Using log driver for local development)
# =============================================================================
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@waste-management.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
